+  env: AstraContextEnv
+): Promise<string> {
+  const result = await databases.listDocuments(databaseId, env.knowledgeBaseCollectionId, [
+    Query.equal('official_source_id', officialSourceId),
+    Query.equal('status', 'PUBLISHED'),
+    Query.limit(20),
+  ]);
