{
  "name": "asillia-datainsight",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "appwrite/functions/*"
  ],
  "devDependencies": {
    "esbuild": "^0.23.0"
  },
  "scripts": {
    "dev:collect": "npm run dev --workspace=apps/collect",
    "dev:studio": "npm run dev --workspace=apps/studio",
    "build:collect": "npm run build --workspace=apps/collect",
    "build:studio": "npm run build --workspace=apps/studio",
    "dev:showcase": "npm run dev --workspace=showcase",
    "build:showcase": "npm run build --workspace=showcase"
  }
}
